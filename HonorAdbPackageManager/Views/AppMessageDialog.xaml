<Window x:Class="HonorAdbPackageManager.Views.AppMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo-256.png"
        Width="520"
        MinHeight="150"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="{StaticResource AeroWindowBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <StackPanel Margin="20,18">

        <!-- 语义横幅条：与 ConfirmDialog 风险标题条同构 -->
        <Border x:Name="Banner" CornerRadius="8" Padding="12,9">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconCircle" Width="22" Height="22" CornerRadius="11"
                        VerticalAlignment="Center" Margin="0,0,9,0">
                    <Grid>
                        <TextBlock x:Name="IconGlyph" FontSize="12.5" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,-1,0,0"/>
                        <Path x:Name="CheckIcon" Stroke="White" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M5,11.5 L9.5,16 L17.5,7"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="BannerText" FontSize="13.5" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 正文说明块：与 ConfirmDialog 风险说明块同构 -->
        <Border Background="{StaticResource WindowBackBrush}" CornerRadius="8"
                Padding="12,10" Margin="0,14,0,0">
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource TextPrimary}"/>
        </Border>

        <!-- 按钮组：右下，与 ConfirmDialog 一致 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LeftButton" Style="{StaticResource GhostButton}"
                    Width="86" Click="Left_Click"/>
            <Button x:Name="MidButton" Style="{StaticResource GhostButton}"
                    Width="86" Margin="10,0,0,0" Visibility="Collapsed" Click="Mid_Click"/>
            <Button x:Name="RightButton" Width="96" Margin="10,0,0,0" Click="Right_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
