<Window x:Class="HonorAdbPackageManager.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作确认"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo-256.png"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="{StaticResource AeroWindowBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <StackPanel Margin="20,18">

        <!-- 风险标题条 -->
        <Border Background="{StaticResource DangerLightBrush}" CornerRadius="8" Padding="12,9"
                x:Name="RiskBanner">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="16" Foreground="{StaticResource DangerBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="RiskTitleText" FontSize="13.5" FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}"
                           Text="高风险操作确认"/>
            </StackPanel>
        </Border>

        <!-- 包信息 -->
        <StackPanel Margin="0,14,0,0">
            <TextBlock x:Name="AppNameText" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="PackageText" FontSize="12" Margin="0,3,0,0"
                       Foreground="{StaticResource TextSecondary}"/>
            <TextBlock x:Name="RiskLevelText" FontSize="12" Margin="0,3,0,0"
                       Foreground="{StaticResource WarnBrush}"/>
        </StackPanel>

        <!-- 风险说明 -->
        <Border Background="{StaticResource WindowBackBrush}" CornerRadius="8"
                Padding="12,10" Margin="0,12,0,0">
            <TextBlock x:Name="RiskBodyText" TextWrapping="Wrap" FontSize="12.5"
                       Foreground="{StaticResource TextPrimary}"/>
        </Border>

        <!-- 我已知晓风险勾选 -->
        <CheckBox x:Name="AckCheckbox" Content="我已知晓风险，确认执行"
                  FontSize="13" Margin="2,14,0,0"
                  Checked="AckCheckbox_Changed" Unchecked="AckCheckbox_Changed"/>

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}"
                    Width="86" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Content="确认执行" Style="{StaticResource DangerButton}"
                    Width="110" Margin="10,0,0,0" IsEnabled="False" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
