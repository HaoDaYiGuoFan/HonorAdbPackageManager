<Window x:Class="HonorAdbPackageManager.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/logo-256.png"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="{StaticResource CardBackBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <StackPanel Margin="20,18">
        <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimary}"/>
        <TextBlock x:Name="HintText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}"/>
        <Border Background="{StaticResource WindowBackBrush}" CornerRadius="6"
                Padding="10,8" Margin="0,14,0,0">
            <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                     FontSize="13" FontFamily="Consolas, Microsoft YaHei UI"
                     VerticalContentAlignment="Center"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}"
                    Width="86" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="确定" Style="{StaticResource PrimaryButton}"
                    Width="86" Margin="10,0,0,0" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
