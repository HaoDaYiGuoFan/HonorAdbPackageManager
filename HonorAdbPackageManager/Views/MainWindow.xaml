<Window x:Class="HonorAdbPackageManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/logo-256.png"
        xmlns:conv="clr-namespace:HonorAdbPackageManager.Converters"
        Height="860"
        Width="1280"
        MinHeight="640"
        MinWidth="1000"
        Background="{StaticResource WindowBackBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:EnumDisplayConverter x:Key="EnumDisplay"/>
        <conv:RiskBrushConverter x:Key="RiskBrush"/>
        <conv:RiskTextBrushConverter x:Key="RiskTextBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:PackageNameInitialConverter x:Key="PkgInitial"/>
        <conv:AppLabelConverter x:Key="AppLabel"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 常驻红色提示 ============ -->
        <Border Grid.Row="0" Background="{StaticResource DangerLightBrush}" Padding="16,7">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="{StaticResource DangerBrush}"
                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                           FontSize="12.5" FontWeight="SemiBold"
                           Text="本工具为 ADB 调试辅助，非 ROOT 工具：系统包仅停用不删除；操作前建议备份手机数据；禁用核心包可能导致设备异常。"/>
            </StackPanel>
        </Border>

        <!-- ============ 顶部工具栏 ============ -->
        <Border Grid.Row="1" Background="{StaticResource CardBackBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding RefreshDeviceCommand}" Content="刷新设备"
                        Style="{StaticResource PrimaryButton}"/>
                <Button Command="{Binding WirelessConnectCommand}" Content="连接无线 ADB"
                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                <Button Command="{Binding WirelessDisconnectCommand}" Content="断开连接"
                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                <Button Command="{Binding LoadPackagesCommand}" Content="拉取全部应用包"
                        Style="{StaticResource PrimaryButton}" Margin="14,0,0,0"/>
                <Button Command="{Binding BackupSelectedCommand}" Content="备份选中 APK"
                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                <Button Command="{Binding ImportKnowledgeCommand}" Content="导入外部知识库"
                        Style="{StaticResource GhostButton}" Margin="14,0,0,0"/>
                <Button Command="{Binding ShowLogCommand}" Content="执行日志"
                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>

                <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="14,0"/>

                <Border Background="{StaticResource WindowBackBrush}"
                        CornerRadius="6" Width="260" Height="32">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Margin="6,0,10,0"
                                 FontSize="13" CaretBrush="{StaticResource AccentBrush}"/>
                    </Grid>
                </Border>

                <ComboBox ItemsSource="{Binding TypeFilterOptions}"
                          SelectedItem="{Binding TypeFilter}"
                          Width="140" Height="32" Margin="8,0,0,0"
                          VerticalContentAlignment="Center" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- ============ 主体两栏 ============ -->
        <Grid Grid.Row="2" Margin="14,10,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--  左侧设备信息面板  -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="设备信息" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding AdbProbeText}" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,4,0,12"/>

                        <Border Background="{StaticResource WindowBackBrush}" CornerRadius="8"
                                Padding="12,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#C2C7CC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeviceOnline}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SafeBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding DeviceStatusText}" FontSize="12.5"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="型号" Style="{StaticResource InfoKey}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Device.Model}" Style="{StaticResource InfoValue}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="品牌" Style="{StaticResource InfoKey}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Device.Brand}" Style="{StaticResource InfoValue}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="MagicOS" Style="{StaticResource InfoKey}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Device.MagicOsVersion}" Style="{StaticResource InfoValue}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Android" Style="{StaticResource InfoKey}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Device.AndroidVersion}" Style="{StaticResource InfoValue}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="SDK" Style="{StaticResource InfoKey}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Device.SdkVersion}" Style="{StaticResource InfoValue}"/>
                        </Grid>

                        <Border Background="{StaticResource WarnLightBrush}" CornerRadius="8"
                                Padding="12,9" Margin="0,0,0,12">
                            <TextBlock FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource WarnBrush}"
                                       Text="手机需开启开发者选项与 USB 调试；首次连接请在手机上允许 RSA 调试授权。"/>
                        </Border>

                        <TextBlock Text="包统计" FontSize="14" FontWeight="Bold" Margin="0,4,0,10"/>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Border Style="{StaticResource StatCard}" Margin="0,0,6,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalCount}" FontSize="19" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="全部" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding EnabledCount}" FontSize="19" FontWeight="Bold"
                                               Foreground="{StaticResource SafeBrush}"/>
                                    <TextBlock Text="已启用" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisabledCount}" FontSize="19" FontWeight="Bold"
                                               Foreground="{StaticResource WarnBrush}"/>
                                    <TextBlock Text="已停用" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding UnknownCount}" FontSize="19" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="未知应用" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="会话操作记录" FontSize="14" FontWeight="Bold" Margin="0,4,0,8"/>
                        <Border Background="{StaticResource WindowBackBrush}" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           Text="{Binding SessionActionCount, StringFormat=本次会话已执行 {0} 次操作}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="选中列表条目可在底部详情查看该包的操作历史。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  中间主列表  -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <TextBlock Text="应用包列表" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsLoadingPackages, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Width="180" Height="6"
                                         Maximum="{Binding ProgressTotal, Mode=OneWay}"
                                         Value="{Binding ProgressDone, Mode=OneWay}"/>
                            <TextBlock Text="{Binding ProgressText}" Margin="10,0,0,0"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              x:Name="PackagesGrid"
                              Style="{StaticResource PackageGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              RowStyle="{StaticResource GridRow}"
                              CellStyle="{StaticResource GridCell}"
                              ItemsSource="{Binding FilteredItems}"
                              SelectedItem="{Binding SelectedItem}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="图标" Width="52" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Image Source="{Binding Icon}" Width="32" Height="32"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Border Style="{StaticResource IconPlaceholder}"
                                                    Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=Placeholder}">
                                                <TextBlock Text="{Binding PackageName, Converter={StaticResource PkgInitial}}"
                                                           FontWeight="Bold" FontSize="15"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="应用名称" Width="180" SortMemberPath="AppLabel">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppLabel, Converter={StaticResource AppLabel}}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding VersionName}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="包名" Binding="{Binding PackageName, Mode=OneWay}" Width="270" SortMemberPath="PackageName">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="类型" Width="84" SortMemberPath="PackageType">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource InfoLightBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PackageType}" Value="SystemCritical">
                                                            <Setter Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PackageType}" Value="ThirdParty">
                                                            <Setter Property="Background" Value="{StaticResource SafeLightBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PackageType, Converter={StaticResource EnumDisplay}}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="风险等级" Width="90" SortMemberPath="UninstallRisk">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Left"
                                                Background="{Binding UninstallRisk, Converter={StaticResource RiskBrush}}">
                                            <TextBlock Text="{Binding UninstallRisk, Converter={StaticResource EnumDisplay}}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding UninstallRisk, Converter={StaticResource RiskTextBrush}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="当前状态" Width="78" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource EnumDisplay}}"
                                                   FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SafeBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Uninstalled">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="功能说明" Width="*" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   ToolTip="{Binding Description}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="操作" Width="126" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button Content="{Binding ActionButtonText}"
                                                    Command="{Binding DataContext.PackageActionCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Padding" Value="12,4"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Status}" Value="Enabled"/>
                                                                    <Condition Binding="{Binding CanUninstall}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="还原启用"
                                                    Command="{Binding DataContext.PackageActionCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Padding" Value="12,4"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Status}" Value="Disabled"/>
                                                                    <Condition Binding="{Binding CanUninstall}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- 禁止操作：灰化 + 悬浮提示 -->
                                            <Button Content="禁止操作" IsHitTestVisible="True" IsEnabled="False"
                                                    ToolTip="该组件为系统核心，禁用会导致设备异常">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Padding" Value="12,4"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Status}" Value="Enabled"/>
                                                                    <Condition Binding="{Binding CanUninstall}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="无法还原"
                                                    IsEnabled="False"
                                                    ToolTip="第三方应用已彻底卸载，需要 APK 重新安装"
                                                    Command="{Binding DataContext.RestoreHintCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Padding" Value="12,4"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Uninstalled">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="📦" FontSize="44" HorizontalAlignment="Center"/>
                        <TextBlock Text="连接设备后点击【拉取全部应用包】" Margin="0,10,0,0"
                                   Foreground="{StaticResource TextSecondary}" FontSize="13.5"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource WarnLightBrush}" CornerRadius="6"
                            Padding="10,6" Margin="0,8,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ProgressText}" Margin="9,0,0,0" FontSize="12"
                                       Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 底部详情面板 ============ -->
        <Border Grid.Row="3" Margin="14,0,14,10" Style="{StaticResource CardBorder}"
                Padding="16,12"
                Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <Grid Width="72" VerticalAlignment="Top">
                    <Image Source="{Binding SelectedItem.Icon}" Width="64" Height="64"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border Style="{StaticResource IconPlaceholder}" Width="64" Height="64"
                            Visibility="{Binding SelectedItem.Icon, Converter={StaticResource NullToVis}, ConverterParameter=Placeholder}">
                        <TextBlock Text="{Binding SelectedItem.PackageName, Converter={StaticResource PkgInitial}}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Margin="18,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedItem.AppLabel, Converter={StaticResource AppLabel}}"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <Border CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                Background="{Binding SelectedItem.UninstallRisk, Converter={StaticResource RiskBrush}}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedItem.UninstallRisk, Converter={StaticResource EnumDisplay}}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding SelectedItem.UninstallRisk, Converter={StaticResource RiskTextBrush}}"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedItem.Status, Converter={StaticResource EnumDisplay}, StringFormat=状态：{0}}"
                                   Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedItem.PackageName}" FontSize="12.5"
                               Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    <TextBlock FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimary}"
                               Text="{Binding SelectedItem.Description}"/>
                    <TextBlock FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondary}">
                        <Run Text="版本："/><Run Text="{Binding SelectedItem.VersionName, Mode=OneWay}"/>
                        <LineBreak/>
                        <Run Text="APK："/><Run Text="{Binding SelectedItem.SourceApkPath, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Margin="0,9,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Text="{Binding DetailThirdHint}"/>
                    <TextBlock Margin="0,3,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource SafeBrush}"
                               Text="{Binding DetailSystemHint}"/>
                    <TextBlock Margin="0,3,0,0" FontSize="12.5" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"
                               Text="{Binding DetailCriticalWarning}"/>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource WindowBackBrush}"
                        CornerRadius="8" Padding="12,9">
                    <StackPanel>
                        <TextBlock Text="操作历史（本次会话）" FontSize="12.5" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding SelectedItem.HistoryView}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="4" Background="{StaticResource CardBackBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding KnowledgeSourceText}" FontSize="11.5"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="    |    " FontSize="11.5" Foreground="{StaticResource BorderBrush}"/>
                    <TextBlock Text="{Binding FilterSummary}" FontSize="11.5"
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" FontSize="11.5"
                           Foreground="{StaticResource TextSecondary}"
                           Text="仅自用 · 操作前建议备份手机 · 不做系统限制绕过"/>
            </Grid>
        </Border>

        <!-- 全屏遮罩（加载中） -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#66FFFFFF"
                Visibility="{Binding IsLoadingPackages, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Width="260" Height="8" Maximum="{Binding ProgressTotal, Mode=OneWay}"
                             Value="{Binding ProgressDone, Mode=OneWay}"/>
                <TextBlock Text="{Binding ProgressText}" Margin="0,10,0,0"
                           HorizontalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
