<Window x:Class="HonorAdbPackageManager.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADB 执行日志"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo-256.png"
        Height="560"
        Width="900"
        Background="{StaticResource AeroWindowBrush}"
        FontFamily="Consolas, Microsoft YaHei UI"
        FontSize="12.5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="ADB 命令实时输出（stdout / stderr + 返回码）"
                       FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True"
                          VerticalAlignment="Center" FontSize="12"
                          FontFamily="Microsoft YaHei UI"/>
                <Button Content="清空显示" Style="{StaticResource GhostButton}"
                        Margin="12,0,0,0" Click="Clear_Click"/>
                <Button Content="导出 TXT" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Click="Export_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource ConsoleGlassBrush}" CornerRadius="10"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="10">
            <TextBox x:Name="LogTextBox"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource ConsoleTextBrush}"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="日志仅本次会话内存保存，关闭程序自动清空。"
                       FontFamily="Microsoft YaHei UI" FontSize="11"
                       Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>
    </Grid>
</Window>
