<Window x:Class="HonorAdbPackageManager.Views.PackageDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:HonorAdbPackageManager.Converters"
        Title="应用详情"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo-256.png"
        Height="720" Width="640"
        Background="{StaticResource AeroWindowBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="12.5">
    <Window.Resources>
        <!-- BoolToVis 定义在 MainWindow.Resources 中，本窗口不可见，需本地声明 -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：应用信息 -->
        <Border Grid.Row="0" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HeaderText" Text="—" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="VersionText" Text="" FontSize="12" VerticalAlignment="Center" Margin="10,2,0,0"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="StatusText" Text="" FontSize="11.5" VerticalAlignment="Center" Margin="10,2,0,0"
                               Foreground="{StaticResource WarnBrush}"/>
                </StackPanel>
                <TextBlock x:Name="PkgText" Text="—" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- 加载中 -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="⏳ 正在查询权限 / 存储 / 流量 / 启动控制 …" FontSize="13"
                       Foreground="{StaticResource TextSecondary}"/>
            <TextBlock x:Name="LoadErrorText" Text="" FontSize="12" Foreground="{StaticResource DangerBrush}"
                       Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="480"/>
        </StackPanel>

        <!-- 详情内容 -->
        <ScrollViewer x:Name="ContentPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,4,0">

                <!-- ── 权限 ── -->
                <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🔒 手机权限" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="按保护级别分块：危险（红）/ 签名·系统（蓝）/ 普通（灰）/ 开发（橙）；✓ 已允许 · ✗ 已禁止"
                                   FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="开关说明：运行时权限（危险级）与悬浮窗/修改设置可启用/停用，停用会弹确认；普通/签名级由安装时授予，adb 无法更改"
                                   FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,4" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PermOpStatus" Text="" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap"
                                   Foreground="{StaticResource SafeBrush}"/>
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,6">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LevelKey}" Value="dangerous">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LevelKey}" Value="signature">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LevelKey}" Value="development">
                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LevelKey}" Value="normal">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="8,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayText}" FontSize="11.5"
                                                                           Foreground="{StaticResource TextPrimary}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                                <TextBlock Text="{Binding GrantedDisplay}" FontSize="11" Margin="10,0,0,0"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding GrantedTone}" Value="safe">
                                                                                    <Setter Property="Foreground" Value="{StaticResource SafeBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding GrantedTone}" Value="danger">
                                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <!-- 中文作用说明 -->
                                                            <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       TextWrapping="Wrap" Margin="0,1,0,0"
                                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                  IsChecked="{Binding Granted, Mode=OneWay}"
                                                                  IsEnabled="{Binding CanToggle}"
                                                                  Click="PermToggle_Click" ToolTip="{Binding ToggleHint}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="该包未声明任何权限" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasPermissions, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Border>

                <!-- ── 存储空间 ── -->
                <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💾 占用存储空间" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <UniformGrid Columns="4" Margin="0,8,0,0">
                            <Border Background="{StaticResource GlassInputBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding AppSizeText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="应用" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource GlassInputBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding DataSizeText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="数据" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource GlassInputBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding CacheSizeText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="缓存" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource GlassInputBrush}" CornerRadius="8" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalSizeText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SafeBrush}"/>
                                    <TextBlock Text="总计" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="来源 dumpsys diskstats（系统聚合快照）；数值为 0 表示该维度暂无占用"
                                   FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ── 流量使用 ── -->
                <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📶 流量使用情况" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <Border Background="{StaticResource GlassInputBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding RxText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="下载" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource GlassInputBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding TxText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="上传" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource GlassInputBrush}" CornerRadius="8" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalTrafficText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SafeBrush}"/>
                                    <TextBlock Text="合计" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="来源 dumpsys netstats（BPF 统计，开机以来累计，含 WLAN 与移动数据）；分身/隐私空间同应用的流量已合并"
                                   FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ── 启动控制 ── -->
                <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🚀 启动控制" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <ItemsControl ItemsSource="{Binding StartupControls}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Key"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="12" FontWeight="SemiBold"
                                                       Margin="12,0,0,0" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="safe">
                                                                <Setter Property="Foreground" Value="{StaticResource SafeBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="warn">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="danger">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,1,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部说明 -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="数据来源：dumpsys package / diskstats / netstats / appops（Android 标准层）；MagicOS 应用启动管理为私有存储，ADB 不可读。"
                       FontSize="10.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            <Button Content="关闭" Style="{StaticResource GhostButton}" Width="90" Height="30"
                    HorizontalAlignment="Right" Margin="0,8,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
