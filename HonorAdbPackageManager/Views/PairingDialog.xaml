<Window x:Class="HonorAdbPackageManager.Views.PairingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无线 ADB 配对"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo-256.png"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="{StaticResource AeroWindowBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <StackPanel Margin="20,18">
        <TextBlock Text="与手机配对（首次使用只需一次）"
                   FontSize="14" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimary}"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}"
                   Text="手机端打开：设置 → 开发人员选项 → 无线调试 → 『使用配对码配对设备』，保持弹窗停留，把弹窗显示的 IP:端口 与 6 位配对码填到下面。注意配对端口与连接端口（37453 这类）不同，且每次打开弹窗都会变化。"/>
        <TextBlock Text="配对地址（手机弹窗显示的 IP:端口）"
                   Margin="0,14,0,4"
                   Foreground="{StaticResource TextPrimary}"/>
        <Border Background="{StaticResource WindowBackBrush}" CornerRadius="6"
                Padding="10,8">
            <TextBox x:Name="AddrBox" BorderThickness="0" Background="Transparent"
                     FontSize="13" FontFamily="Consolas, Microsoft YaHei UI"
                     VerticalContentAlignment="Center"/>
        </Border>
        <TextBlock Text="6 位配对码"
                   Margin="0,12,0,4"
                   Foreground="{StaticResource TextPrimary}"/>
        <Border Background="{StaticResource WindowBackBrush}" CornerRadius="6"
                Padding="10,8">
            <TextBox x:Name="CodeBox" BorderThickness="0" Background="Transparent"
                     FontSize="16" FontFamily="Consolas"
                     MaxLength="6" VerticalContentAlignment="Center"
                     CharacterCasing="Upper"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}"
                    Width="86" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="配对" Style="{StaticResource PrimaryButton}"
                    Width="86" Margin="10,0,0,0" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
