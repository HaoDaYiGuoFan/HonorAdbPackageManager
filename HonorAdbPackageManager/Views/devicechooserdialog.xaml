<Window x:Class="HonorAdbPackageManager.Views.DeviceChooserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择设备"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo-256.png"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="{StaticResource AeroWindowBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <StackPanel Margin="20,18">
        <TextBlock Text="检测到多台设备，请选择要管理的设备："
                   FontSize="13.5" Foreground="{StaticResource TextPrimary}"/>
        <ListBox x:Name="DeviceList" Margin="0,12,0,0" Height="170"
                 Background="{StaticResource WindowBackBrush}"
                 BorderThickness="0" FontSize="12.5"
                 FontFamily="Consolas, Microsoft YaHei UI"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}"
                    Width="86" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="连接" Style="{StaticResource PrimaryButton}"
                    Width="86" Margin="10,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
