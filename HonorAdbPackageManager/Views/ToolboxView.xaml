<UserControl x:Class="HonorAdbPackageManager.Views.ToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部操作条：一键停用 / 还原所有 -->
        <Border Grid.Row="0" Background="#FDE3EA" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚡ 批量操作（每个包都会双重确认防误触）"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#D4879E" VerticalAlignment="Center"/>
                <Button Content="一键停用冗余服务" Command="{Binding SafePresetCommand}"
                        Style="{StaticResource DangerButton}" Margin="14,0,0,0" Padding="14,7"/>
                <Button Content="还原本会话所有停用" Command="{Binding RestoreAllCommand}"
                        Style="{StaticResource GhostButton}" Margin="10,0,0,0" Padding="14,7"/>
            </StackPanel>
        </Border>

        <!-- 分类卡片流式布局 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
        </ScrollViewer>
    </Grid>
</UserControl>
